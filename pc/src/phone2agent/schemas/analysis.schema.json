{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "phone2agent call analysis",
  "type": "object",
  "additionalProperties": false,
  "required": ["title", "summary", "participants", "items", "routes", "actions"],
  "properties": {
    "title": {"type": "string"},
    "summary": {"type": "string"},
    "participants": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["name", "role"],
        "properties": {"name": {"type": "string"}, "role": {"type": "string"}}
      }
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["kind", "text", "owner", "due", "project", "quote"],
        "properties": {
          "kind": {"type": "string", "enum": ["todo", "progress", "approach", "handoff", "decision", "info", "risk"]},
          "text": {"type": "string"},
          "owner": {"type": ["string", "null"]},
          "due": {"type": ["string", "null"]},
          "project": {"type": ["string", "null"]},
          "quote": {"type": "string"}
        }
      }
    },
    "routes": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["project", "confidence", "reason", "notes_markdown"],
        "properties": {
          "project": {"type": "string"},
          "confidence": {"type": "number", "minimum": 0, "maximum": 1},
          "reason": {"type": "string"},
          "notes_markdown": {"type": "string"}
        }
      }
    },
    "actions": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["title", "project", "instructions", "reason"],
        "properties": {
          "title": {"type": "string"},
          "project": {"type": ["string", "null"]},
          "instructions": {"type": "string"},
          "reason": {"type": "string"}
        }
      }
    }
  }
}
