[Unit]
Description=phone2agent recording pipeline

[Service]
# For venv or pipx installs, override ExecStart with that environment's p2a path.
ExecStart=%h/.local/bin/p2a daemon
Restart=on-failure
RestartSec=60
Environment=PYTHONUNBUFFERED=1
# Let the daemon finish its active recording without terminating its child agent.
KillMode=mixed
TimeoutStopSec=infinity

[Install]
WantedBy=default.target
